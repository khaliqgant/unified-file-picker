# Nango Configuration
# Get these from your Nango dashboard at https://app.nango.dev
NANGO_SECRET_KEY=your_nango_secret_key_here
NANGO_HOST=https://api.nango.dev
NEXT_PUBLIC_NANGO_CONNECT_TOKEN=your_nango_connect_token_here

# Nango Integration IDs (configure these in your Nango dashboard)
# These should match the integration IDs you create in Nango
NANGO_GOOGLE_DRIVE_ID=google-drive
NANGO_DROPBOX_ID=dropbox
NANGO_ONEDRIVE_ID=microsoft-onedrive
NANGO_BOX_ID=box
NANGO_SHAREPOINT_ID=microsoft-sharepoint
NANGO_CONFLUENCE_ID=atlassian-confluence
NANGO_NOTION_ID=notion
NANGO_S3_ID=amazon-s3
